---
// src/pages/blog/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/wp';
import type { Post } from '../../lib/wp';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<Layout title={`${post.titulo} — Tueste Norte`}>
  <main class="max-w-3xl mx-auto px-4 py-8">
    <a href="/blog/" class="text-amber-700 hover:underline mb-4 inline-block">&larr; Volver al blog</a>
    
    <article class="bg-white p-6 rounded-lg shadow-md">
      <span class="text-sm text-gray-500 mb-2 block">{post.fecha}</span>
      <h1 class="text-3xl font-bold mb-6">{post.titulo}</h1>
      
      {post.imagen && (
        <img 
          src={post.imagen} 
          alt={post.imagenAlt} 
          class="w-full h-72 object-cover rounded-md mb-6"
        />
      )}

      <div class="prose max-w-none text-gray-800 space-y-4" set:html={post.contenidoHtml} />
    </article>
  </main>
</Layout>